# Database
DB_USER=financiallife
DB_PASSWORD=devpassword
DB_NAME=financial_life_dev
DATABASE_URL=postgres://financiallife:devpassword@localhost:5432/financial_life_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT & Auth
JWT_SECRET=dev-jwt-secret-change-in-production
NEXTAUTH_SECRET=dev-nextauth-secret-change-in-production

# AI & LLM
CLAUDE_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=optional_openai_api_key

# External Integrations
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox  # sandbox or production

# AWS (for Textract, S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=financial-life-documents

# Email & Notifications
SENDGRID_API_KEY=your_sendgrid_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key

# Environment
NODE_ENV=development
NEXT_ENV=development

# Service URLs (for docker-compose, use service names)
BACKEND_URL=http://localhost:3001
AI_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
